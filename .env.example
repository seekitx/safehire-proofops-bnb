APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
GITHUB_REPO_URL=
DATA_DIR=.data
SQLITE_PATH=.data/safehire.db
EVIDENCE_LEDGER_PATH=.data/evidence.jsonl
PLUGIN_CONFIG=config/plugins.json
AGENT_CONFIG=config/agents.json

# Execution is fail-closed.
EXECUTION_MODE=demo
EXECUTION_ADAPTER=demo
ALLOW_ONCHAIN_EXECUTION=false
ALLOW_BSC_MAINNET=false
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org

# Official read-only discovery sources. Keys stay server-side and are optional
# except that PancakeSwap's production The Graph gateway requires its API key.
OFFICIAL_SOURCE_TIMEOUT_SECONDS=10
SCAN8004_API_KEY=
THE_GRAPH_API_KEY=
PANCAKE_V3_SUBGRAPH_ID=Hv1GncLY5docZoGtXjo4kwbTvxm3MAhVZqBZE4sUT9eZ

# Contract deployment: use only a disposable BSC Testnet wallet. Never commit it.
BSC_DEPLOYER_PRIVATE_KEY=
POLICY_EXECUTOR=
POLICY_TARGET=
POLICY_SELECTOR=
POLICY_MAX_PER_CALL_WEI=0
POLICY_MAX_TOTAL_WEI=0
POLICY_TTL_SECONDS=3600

# Optional OpenAI-compatible DeepSeek provider. The deterministic system works without it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=20

# Optional BNB Agent SDK / ERC-8183 adapter values.
BNB_AGENT_SDK_ENABLED=false
ERC8183_AGENT_URL=
ERC8183_PROVIDER_ADDRESS=
ERC8183_NETWORK=bsc-testnet
REMOTE_AGENT_AUTH_TOKEN=
REMOTE_AGENT_TIMEOUT_SECONDS=30

# Admin API protection. Set a long random value in deployed environments.
ADMIN_API_KEY=change-me-before-deploy
CORS_ALLOW_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
